{
  "name": "@vows/server",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.717.0",
    "@aws-sdk/s3-request-presigner": "3.717.0",
    "@nestjs/common": "11.0.1",
    "@nestjs/core": "11.0.1",
    "@nestjs/platform-express": "11.0.1",
    "@sentry/node": "8.47.0",
    "@vows/contracts": "workspace:*",
    "@vows/db": "workspace:*",
    "@vows/mail": "workspace:*",
    "drizzle-orm": "0.38.3",
    "jose": "5.9.6",
    "pg": "8.13.1",
    "pg-boss": "10.1.5",
    "pino": "9.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.0.1",
    "@swc/core": "1.10.4",
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@vows/config": "workspace:*",
    "supertest": "7.0.0",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
