    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@vows/config": "workspace:*",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
