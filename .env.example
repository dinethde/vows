# Chapter 06 of architecture.md. Names only — never a working value.
# Every secret here exists as an item in Bitwarden first. Vercel, Fly and
# GitHub are places you push to, never the place a value is born.

APP_ENV=

# database — Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# auth — Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# storage — Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ORIGINALS=
R2_BUCKET_PUBLIC=
NEXT_PUBLIC_MEDIA_URL=

# mail — Resend
RESEND_API_KEY=
STUDIO_NOTIFY_EMAIL=

# the rebuild endpoint
REVALIDATE_SECRET=

# urls
NEXT_PUBLIC_SITE_URL=
API_URL=
# the same two origins, as the API and the worker name them
SITE_URL=
MEDIA_URL=
# the web origins a Clerk token may be minted for, comma separated
WEB_ORIGINS=

# salts the IP hash kept with an enquiry
IP_HASH_SALT=

# analytics — Cloudflare Web Analytics (no cookie, no banner)
NEXT_PUBLIC_CF_BEACON_TOKEN=

# observability
SENTRY_DSN=
LOG_LEVEL=

# runtime knobs, set per app in infra/fly.*.toml
PORT=
WORKER_CONCURRENCY=
