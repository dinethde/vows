{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./**/.next/**)",
      "Read(./**/dist/**)",
      "Read(./**/.turbo/**)",
      "Read(./packages/tokens/tokens.css)",
      "Read(./packages/tokens/tokens.ts)",
      "Read(./packages/tokens/tailwind.preset.js)",
      "Read(./pnpm-lock.yaml)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(fly:*)",
      "Bash(vercel:*)",
      "Bash(neonctl:*)",
      "Bash(wrangler:*)",
      "Bash(pnpm db:migrate:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commit.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.sh" }
        ]
      }
    ]
  }
}
